# ========================================================
# 应用
# ========================================================

APP_NAME=KnowledgeOps Console
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000

# 生产环境必须替换为随机密钥
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ========================================================
# PostgreSQL
# ========================================================

DATABASE_URL=postgresql+asyncpg://agent:agent_password@postgres:5432/agent_db
CHECKPOINT_DATABASE_URL=postgresql://agent:agent_password@postgres:5432/agent_db

# ========================================================
# Redis
# ========================================================

REDIS_URL=redis://redis:6379/0

# ========================================================
# Qdrant
# ========================================================

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ========================================================
# 模型
# ========================================================

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=ollama

CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_MAX_ROUNDS=8
MODEL_MAX_TOOL_CALLS=12

# ========================================================
# RAG
# ========================================================

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

RAG_COLLECTION_PREFIX=rag
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_BATCH_SIZE=16
RAG_QDRANT_UPSERT_BATCH_SIZE=64

INGEST_WORKER_CONCURRENCY=2
INGEST_MAX_RETRIES=3
INGEST_LEASE_SECONDS=300
INGEST_QUEUE_NAME=rag:ingest

# ========================================================
# Agent
# ========================================================

AGENT_QUEUE_NAME=agent:runs
AGENT_WORKER_CONCURRENCY=2
AGENT_LEASE_SECONDS=300
RUN_TIMEOUT_SECONDS=600

# ========================================================
# Memory
# ========================================================

MEMORY_SHORT_TERM_TOKEN_BUDGET=12000
MEMORY_SUMMARY_TRIGGER_TOKENS=8000
MEMORY_SUMMARY_TOKEN_BUDGET=2000
MEMORY_DEFAULT_TTL_DAYS=90

# ========================================================
# MCP
# ========================================================

MCP_CONFIG_PATH=mcp_servers.json
MCP_CONNECT_TIMEOUT_SECONDS=20
MCP_TOOL_TIMEOUT_SECONDS=60

# ========================================================
# API / 日志
# ========================================================

ACCESS_TOKEN_EXPIRE_MINUTES=120
MAX_UPLOAD_BYTES=52428800
MAX_QUESTION_LENGTH=20000

LOG_LEVEL=INFO

OTEL_ENABLED=false
OTEL_SERVICE_NAME=knowledgeops-console
OTEL_EXPORTER_OTLP_ENDPOINT=
